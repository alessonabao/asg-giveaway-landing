# EmailJS credentials for the giveaway form (frontend-only send).
# Copy this file to `.env` and fill in the values from https://dashboard.emailjs.com
# `.env` is gitignored; this example file is committed as the template.

# All three are bundled into the shipped site — expected for EmailJS, the public
# key is meant to be public. Restricting to your domains (Account > Security >
# "Allowed Origins") needs a paid plan.
VITE_EMAILJS_SERVICE_ID=service_xc67t9q
VITE_EMAILJS_TEMPLATE_ID=template_hmuj2el
VITE_EMAILJS_PUBLIC_KEY=A1F-TWoFzSxl6847t
